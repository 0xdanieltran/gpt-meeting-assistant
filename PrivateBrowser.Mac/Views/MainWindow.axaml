<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:AvaloniaWebView;assembly=Avalonia.WebView"
        x:Class="PrivateBrowser.Mac.Views.MainWindow"
        Title="ChatGPT PrivateBrowser"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Topmost="True">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Background="#FAFAFA"
                Padding="5">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Content="←" Width="36" Height="32" Margin="2" Click="BackButton_Click"/>
                <Button Grid.Column="1" Content="→" Width="36" Height="32" Margin="2" Click="ForwardButton_Click"/>
                <Button Grid.Column="2" Content="⟳" Width="36" Height="32" Margin="2" Click="RefreshButton_Click"/>
                <TextBox Grid.Column="3"
                         x:Name="AddressBar"
                         Height="32"
                         Margin="6,2"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         KeyDown="AddressBar_KeyDown"/>
                <Button Grid.Column="4" Content="Go" Width="50" Height="32" Margin="2" Click="GoButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,8,380">
            <wv:WebView x:Name="Browser"
                        Grid.Column="0"/>

            <GridSplitter Grid.Column="1" Width="8" Background="#D0D0D0"/>

            <Border Grid.Column="2"
                    Background="#F7F7F7"
                    BorderBrush="#D8D8D8"
                    BorderThickness="1,0,0,0">
                <Grid Margin="14" RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="Transcript" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Live" FontSize="11" Foreground="#777777"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,8,0,8"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Background="White">
                        <ScrollViewer x:Name="TranscriptScroller">
                            <StackPanel x:Name="TranscriptList" Margin="6"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*">
                        <Button Grid.Column="0" Content="Copy Latest" Height="34" Margin="0,0,4,0" Padding="4,4" Click="CopyLatestButton_Click"/>
                        <Button Grid.Column="1" Content="Copy All" Height="34" Margin="2,0" Padding="4,4" Click="CopyAllButton_Click"/>
                        <Button Grid.Column="2" Content="Paste &amp; Send" Height="34" Margin="2,0" Padding="4,4" Click="PasteAndSendButton_Click"/>
                        <Button Grid.Column="3"
                                Content="Screenshot"
                                Height="34"
                                Margin="2,0"
                                Padding="4,4"
                                ToolTip.Tip="Capture the main display and attach it to ChatGPT. Cmd+Shift+X"
                                Click="ScreenshotButton_Click"/>
                        <Button Grid.Column="4" Content="Clear" Height="34" Margin="4,0,0,0" Padding="4,4" Click="ClearButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
