<Window x:Class="PrivateBrowser.BrowserOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#03FFFFFF"
        AllowsTransparency="True">

    <Grid>
        <wv2:WebView2
            x:Name="WebView"
            Focusable="True"
            IsHitTestVisible="True"/>

        <!--
            WPF layered windows click through alpha-0 pixels. This veil
            keeps ChatGPT hittable without covering the page (HWND airspace
            still draws WebView2 on top).
        -->
        <Border
            Background="#03FFFFFF"
            IsHitTestVisible="False"/>
    </Grid>

</Window>
