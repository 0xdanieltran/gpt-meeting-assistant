<Window
    x:Class="PrivateBrowser.ActivationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PrivateBrowser Activation"
    Width="560"
    Height="420"
    MinWidth="520"
    MinHeight="380"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <TextBlock
            Grid.Row="0"
            Text="PrivateBrowser Activation"
            FontSize="24"
            FontWeight="SemiBold"
            Margin="0,0,0,24" />


        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,20">

            <TextBlock
                Text="Device ID"
                FontWeight="SemiBold"
                Margin="0,0,0,8" />

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="DeviceIdTextBox"
                    Grid.Column="0"
                    Height="38"
                    IsReadOnly="True"
                    VerticalContentAlignment="Center"
                    Padding="10,0"
                    Margin="0,0,10,0" />

                <Button
                    x:Name="CopyDeviceIdButton"
                    Grid.Column="1"
                    Content="Copy"
                    Width="90"
                    Height="38"
                    Click="CopyDeviceIdButton_Click" />

            </Grid>

        </StackPanel>


        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,18">

            <TextBlock
                Text="License Key"
                FontWeight="SemiBold"
                Margin="0,0,0,8" />

            <TextBox
                x:Name="LicenseKeyTextBox"
                Height="38"
                VerticalContentAlignment="Center"
                Padding="10,0" />

        </StackPanel>


        <TextBlock
            Grid.Row="3"
            Text="Copy your Device ID and send it to the administrator. You will receive a license key generated specifically for this device."
            TextWrapping="Wrap"
            Foreground="Gray"
            Margin="0,0,0,20" />


        <Border
            Grid.Row="4"
            Background="#F5F5F5"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,20">

            <TextBlock
                Text="One license key can only be used on this device."
                TextWrapping="Wrap"
                Foreground="#555555" />

        </Border>


        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                x:Name="CancelButton"
                Content="Cancel"
                Width="100"
                Height="38"
                Margin="0,0,10,0"
                Click="CancelButton_Click" />

            <Button
                x:Name="ActivateButton"
                Content="Activate"
                Width="110"
                Height="38"
                Click="ActivateButton_Click" />

        </StackPanel>

    </Grid>

</Window>