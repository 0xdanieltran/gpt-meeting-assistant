<Window x:Class="PrivateBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="ChatGPT PrivateBrowser"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Topmost="True"
        ShowInTaskbar="False"
        >

    <Grid>

        <!-- ===================================================== -->
        <!-- ROOT ROWS -->
        <!-- ===================================================== -->

        <Grid.RowDefinitions>

            <!-- Navigation -->
            <RowDefinition Height="Auto"/>

            <!-- Browser + Captions -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- NAVIGATION BAR -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="0"
            BorderBrush="#DDDDDD"
            BorderThickness="0,0,0,1"
            Background="#FAFAFA"
            Padding="5">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- Back -->

                <Button
                    Grid.Column="0"
                    x:Name="BackButton"
                    Content="←"
                    Width="36"
                    Height="32"
                    Margin="2"
                    Click="BackButton_Click"/>


                <!-- Forward -->

                <Button
                    Grid.Column="1"
                    x:Name="ForwardButton"
                    Content="→"
                    Width="36"
                    Height="32"
                    Margin="2"
                    Click="ForwardButton_Click"/>


                <!-- Refresh -->

                <Button
                    Grid.Column="2"
                    Content="⟳"
                    Width="36"
                    Height="32"
                    Margin="2"
                    Click="RefreshButton_Click"/>


                <!-- Address -->

                <TextBox
                    Grid.Column="3"
                    x:Name="AddressBar"
                    Height="32"
                    Margin="6,2"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    KeyDown="AddressBar_KeyDown"/>


                <!-- Go -->

                <Button
                    Grid.Column="4"
                    Content="Go"
                    Width="50"
                    Height="32"
                    Margin="2"
                    Click="GoButton_Click"/>


                <!-- Capture protection -->

                <ToggleButton
                    Grid.Column="5"
                    x:Name="CaptureProtectionButton"
                    Content="Protected"
                    Width="100"
                    Height="32"
                    Margin="8,2,2,2"
                    IsChecked="True"
                    Checked="CaptureProtectionButton_Checked"
                    Unchecked="CaptureProtectionButton_Unchecked"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- Browser | Splitter | Caption Panel -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="1"
            x:Name="MainContentGrid">

            <Grid.ColumnDefinitions>
                 <!-- Browser -->
                <ColumnDefinition
                    x:Name="BrowserColumn"
                    Width="*"
                    MinWidth="400"/>

                <!-- Splitter -->
                <ColumnDefinition
                    x:Name="SplitterColumn"
                    Width="20"/>

                <!-- Caption panel -->
                <ColumnDefinition
                    x:Name="CaptionColumn"
                    Width="380"
                    MinWidth="280"
                    MaxWidth="850"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- WEBVIEW2 -->
            <!-- ================================================= -->

            <wv2:WebView2
                Grid.Column="0"
                x:Name="Browser"/>

            <!-- ================================================= -->
            <!-- REAL DRAGGABLE SPLITTER -->
            <!-- IMPORTANT: direct child of MainContentGrid -->
            <!-- ================================================= -->

            <GridSplitter
                x:Name="CaptionSplitter"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Background="#FFD0D0D0"
                Cursor="SizeWE"
                ShowsPreview="False"
                Panel.ZIndex="1"/>


            <!-- ================================================= -->
            <!-- COLLAPSE / EXPAND BUTTON -->
            <!-- Also direct child, overlaid on splitter -->
            <!-- ================================================= -->

            <Button
                x:Name="CaptionToggleButton"
                Grid.Column="1"
                Content="▶"
                Width="24"
                Height="32"
                Margin="0,10,0,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                ToolTip="Hide captions"
                Click="CaptionToggleButton_Click"/>

            <!-- <StackPanel
                Grid.Column="6"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="10,0,0,0">

                <TextBlock
                    Text="Opacity"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"/>

                <Slider
                    x:Name="OpacitySlider"
                    Width="120"
                    Minimum="10"
                    Maximum="100"
                    Value="100"
                    TickFrequency="10"
                    IsSnapToTickEnabled="False"
                    ValueChanged="OpacitySlider_ValueChanged"/>

                <TextBlock
                    x:Name="OpacityValueText"
                    Text="100%"
                    Width="42"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"/>

            </StackPanel> -->

            <!-- ================================================= -->
            <!-- CAPTION PANEL -->
            <!-- ================================================= -->


            <Border
                x:Name="CaptionPanel"
                Grid.Column="2"
                Background="#FFF7F7F7"
                BorderBrush="#FFD8D8D8"
                BorderThickness="1,0,0,0">

                <Grid Margin="14">

                    <Grid.RowDefinitions>

                        <!-- Header -->
                        <RowDefinition Height="Auto"/>

                        <!-- Latest -->
                        <RowDefinition Height="Auto"/>

                        <!-- Transcript title -->
                        <RowDefinition Height="Auto"/>

                        <!-- Transcript -->
                        <RowDefinition Height="*"/>

                        <!-- Actions -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ========================================= -->
                    <!-- HEADER -->
                    <!-- ========================================= -->

                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,12">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Grid.Column="0"
                                Text="Live Meeting Captions"
                                FontSize="16"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>


                            <Border
                                Grid.Column="1"
                                Background="#FFEAEAEA"
                                CornerRadius="10"
                                Padding="8,3">

                                <TextBlock
                                    x:Name="CaptionCountText"
                                    Text="0 segments"
                                    FontSize="11"
                                    Foreground="#666666"/>

                            </Border>
                        </Grid>


                        <TextBlock
                            Grid.Row="1"
                            x:Name="MeetingKeyText"
                            Text="No meeting"
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="#777777"
                            TextTrimming="CharacterEllipsis"/>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- LATEST CAPTION -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="#FFE1E1E1"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock
                                Text="Latest"
                                FontSize="11"
                                Foreground="#888888"
                                Margin="0,0,0,7"/>


                            <TextBlock
                                x:Name="LatestSpeakerText"
                                Text="Waiting for captions..."
                                FontWeight="SemiBold"
                                Margin="0,0,0,5"/>


                            <TextBlock
                                x:Name="LatestCaptionText"
                                Text="Google Meet captions will appear here."
                                TextWrapping="Wrap"
                                Foreground="#333333"/>

                        </StackPanel>

                    </Border>


                    <!-- ========================================= -->
                    <!-- TRANSCRIPT HEADER -->
                    <!-- ========================================= -->

                    <Grid
                        Grid.Row="2"
                        Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Grid.Column="0"
                            Text="Transcript"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>


                        <TextBlock
                            Grid.Column="1"
                            Text="Live"
                            FontSize="11"
                            Foreground="#777777"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- FULL TRANSCRIPT -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="3"
                        Background="White"
                        BorderBrush="#FFE1E1E1"
                        BorderThickness="1"
                        CornerRadius="7"
                        Margin="0,0,0,12">

                        <RichTextBox
                            x:Name="TranscriptText"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="True"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="12"
                            FontSize="14">

                            <FlowDocument
                                x:Name="TranscriptDocument"
                                PagePadding="0"
                                FontFamily="Segoe UI">

                                <Paragraph
                                    Foreground="#777777"
                                    Margin="0">
                                    Waiting for meeting captions...
                                </Paragraph>

                            </FlowDocument>

                        </RichTextBox>

                    </Border>


                    <!-- ========================================= -->
                    <!-- ACTION BUTTONS -->
                    <!-- ========================================= -->

                    <Grid
                        Grid.Row="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Button
                            Grid.Column="0"
                            Content="Copy Latest"
                            Height="34"
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Click="CopyLatestButton_Click"/>


                        <Button
                            Grid.Column="1"
                            Content="Copy All"
                            Height="34"
                            Margin="3,0"
                            Padding="8,4"
                            Click="CopyAllButton_Click"/>

                        <Button
                            x:Name="PasteAndSendButton"
                            Grid.Column="2"
                            Content="Paste &amp; Send"
                            Height="34"
                            Margin="3,0"
                            Padding="8,4"
                            Click="PasteAndSendButton_Click"/>


                        <Button
                            Grid.Column="3"
                            Content="Clear"
                            Height="34"
                            Margin="6,0,0,0"
                            Padding="8,4"
                            Click="ClearCaptionsButton_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>